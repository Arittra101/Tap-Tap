<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        MainActivity extends AppCompatActivity so that per-app languages (FR-8.2) work
        below API 33, and AppCompat requires a Theme.AppCompat descendant. The theme does
        nothing visual: everything on screen is drawn by Compose from the design tokens
        (FR-7.4). It only paints the window background while the activity starts, which
        is why `bg` is set here for light and dark.
    -->
    <style name="Theme.TapTap" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/tt_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        The launch theme (the splash screen).

        The window the system paints before the app has drawn anything. Its background is
        the same `bg` token the rest of the app starts with, so the splash does not flash a
        different colour into the first frame, and `postSplashScreenTheme` hands over to the
        real theme once MainActivity calls installSplashScreen().
    -->
    <style name="Theme.TapTap.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tt_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TapTap</item>
    </style>
</resources>
